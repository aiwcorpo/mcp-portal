{
  "name": "mcp-portal-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "generate:api": "rm -rf src/app/api/generated && openapi-generator-cli generate -i node_modules/@aiwcorpo/mcp-contracts/openapi/bundled/portal-bff.v1.bundled.yaml -g typescript-angular -o src/app/api/generated --type-mappings set=Array --global-property apiDocs=false,modelDocs=false --additional-properties ngVersion=22.2.3,supportsES6=true && rm -f src/app/api/generated/git_push.sh src/app/api/generated/README.md src/app/api/generated/.gitignore && perl -pi -e 's/\\| Null;/| null;/' src/app/api/generated/model/*.ts",
    "start:mocks": "ng serve --configuration mocks",
    "build:e2e": "ng build --configuration e2e",
    "e2e": "npm run build:e2e && playwright test",
    "i18n:extract": "ng extract-i18n",
    "i18n:check": "ng extract-i18n --output-path .angular/i18n-check && diff -u src/locale/messages.xlf .angular/i18n-check/messages.xlf"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/localize": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "qrcode-generator": "2.0.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@aiwcorpo/mcp-contracts": "file:.contracts/aiwcorpo-mcp-contracts-6.2.0.tgz",
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "2.42.0",
    "@playwright/test": "1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.5"
  }
}
