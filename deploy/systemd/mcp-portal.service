# systemd unit: /etc/systemd/system/mcp-portal.service
#   systemctl daemon-reload && systemctl enable --now mcp-portal
[Unit]
Description=MCP platform: mcp-portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portal
Group=portal
# Addresses and secrets (deploy/systemd/mcp-portal.env); logs go to journald.
EnvironmentFile=/etc/mcp-portal/mcp-portal.env
# Checks the configuration and the connections (the identity provider must answer); the portal does not start when it fails
# (journalctl -u mcp-portal shows why). The portal keeps no state, so nothing is generated.
ExecStartPre=/usr/bin/java -jar /opt/mcp-portal/portal.jar init
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -jar /opt/mcp-portal/portal.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# The JIT needs writable and executable memory.
MemoryDenyWriteExecute=false
ReadOnlyPaths=/etc/mcp-portal /opt/mcp-portal
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
# Heap is 75 percent of what the unit may use; set the limit to the host's budget.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
