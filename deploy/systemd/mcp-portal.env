# Environment of the portal: copy to /etc/mcp-portal/mcp-portal.env (root:portal, mode 0640) and fill in the empty values.

# Listens on plain HTTP for your TLS reverse proxy; bind it to the loopback address when the proxy shares the host.
PORTAL_PORT=8080
# The built single-page application (web/dist/portal of the repository), copied next to the jar.
PORTAL_WEB_DIST=/opt/mcp-portal/web

PORTAL_PUBLIC_BASE_URL=https://mcp.corp.test
# The address of the reverse proxy, as a regular expression (dots in brackets).
PORTAL_TRUSTED_PROXIES=127[.]0[.]0[.]1

PORTAL_OIDC_ISSUER_URI=https://idp.corp.test/realms/corp
PORTAL_OIDC_CLIENT_ID=mcp-portal-bff
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_STEP_UP_ACR_VALUES=mfa

PORTAL_GATEWAY_ADMIN_URL=https://mcp-gateway.internal:8443
PORTAL_GATEWAY_ADMIN_TLS_NAME=mcp-gateway.internal
PORTAL_BROKER_URL=https://mcp-credential-broker.internal:8443
PORTAL_BROKER_TLS_NAME=mcp-credential-broker.internal

# The client certificate of the portal (CN mcp-portal-bff) and the internal CA, both PKCS12.
PORTAL_TLS_KEYSTORE=/etc/mcp-portal/tls/keystore.p12
PORTAL_TLS_KEYSTORE_PASSWORD=
PORTAL_TLS_TRUSTSTORE=/etc/mcp-portal/tls/truststore.p12
PORTAL_TLS_TRUSTSTORE_PASSWORD=

PORTAL_IGA_ADAPTER=keycloak-groups
PORTAL_IGA_CATALOG_FILE=/etc/mcp-portal/iga-catalog.yaml

# PORTAL_CLIENT_CONFIGS_CLAUDE_CODE_CLIENT_ID=claude-code
# PORTAL_CLIENT_CONFIGS_CLAUDE_CODE_CALLBACK_PORT=33418
# Only when the identity provider has a certificate from your company CA:
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/etc/mcp-portal/tls/jvm-truststore.p12 -Djavax.net.ssl.trustStorePassword=changeit
