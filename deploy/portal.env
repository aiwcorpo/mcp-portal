# Configuration of the portal. Fill in the empty values; "docker compose up -d" tells you what is still missing.
# The portal keeps no state, so nothing is generated.

# The https origin of your reverse proxy: the one public address of the platform (portal, /api, /s/, /mcp). The login callback is
# <this>/api/v1/auth/callback; register exactly that redirect URI at the identity provider.
PORTAL_PUBLIC_BASE_URL=

# Identity provider (a Keycloak realm) and the confidential client of the portal. The portal discovers the endpoints under the issuer
# (<issuer>/.well-known/openid-configuration), so the issuer must be reachable from this host and be the same name the tokens carry.
# For Keycloak: https://<host>/realms/<realm>
PORTAL_OIDC_ISSUER_URI=
PORTAL_OIDC_CLIENT_ID=mcp-portal-bff
PORTAL_OIDC_CLIENT_SECRET=

# What the identity provider reports in the acr claim after a login with a second factor (Keycloak: the level you mapped, for
# example mfa). Needed for registering the Authenticator and for administration. Comma separated.
PORTAL_STEP_UP_ACR_VALUES=

# The gateway: its admin API on the internal TLS port 8443, and the name in its certificate (SAN).
PORTAL_GATEWAY_ADMIN_URL=
PORTAL_GATEWAY_ADMIN_TLS_NAME=mcp-gateway.internal

# The credential broker: its internal TLS address, and the name in its certificate (SAN).
PORTAL_BROKER_URL=
PORTAL_BROKER_TLS_NAME=mcp-credential-broker.internal

# Passwords of certs/keystore.p12 (the client certificate of the portal, CN mcp-portal-bff) and certs/truststore.p12 (the internal CA).
PORTAL_TLS_KEYSTORE_PASSWORD=
PORTAL_TLS_TRUSTSTORE_PASSWORD=

# The address of your reverse proxy, as a regular expression (dots in brackets). X-Forwarded-* is believed from these addresses only;
# without the line only the loopback address is trusted, which is not enough for a proxy on another host. Leave the line out rather
# than empty.
# PORTAL_TRUSTED_PROXIES=10[.]0[.]0[.]5

# The public client that Claude Code uses at the identity provider, and its fixed callback port, for the command the portal shows.
# PORTAL_CLIENT_CONFIGS_CLAUDE_CODE_CLIENT_ID=claude-code
# PORTAL_CLIENT_CONFIGS_CLAUDE_CODE_CALLBACK_PORT=33418

# Only when the identity provider has a certificate from your company CA (see README.md):
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/certs/jvm-truststore.p12 -Djavax.net.ssl.trustStorePassword=changeit

# Only when the browser and the portal reach the identity provider under different names (README.md, "Two names for the identity provider"):
# PORTAL_OIDC_AUTHORIZATION_URI=
# PORTAL_OIDC_TOKEN_URI=
# PORTAL_OIDC_JWK_SET_URI=
# PORTAL_OIDC_USER_INFO_URI=
# PORTAL_OIDC_END_SESSION_URI=
