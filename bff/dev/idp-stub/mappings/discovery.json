{
  "request": { "method": "GET", "urlPath": "/realms/corp/.well-known/openid-configuration" },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "transformers": ["response-template"],
    "jsonBody": {
      "issuer": "{{request.baseUrl}}/realms/corp",
      "authorization_endpoint": "{{request.baseUrl}}/realms/corp/protocol/openid-connect/auth",
      "token_endpoint": "{{request.baseUrl}}/realms/corp/protocol/openid-connect/token",
      "jwks_uri": "{{request.baseUrl}}/realms/corp/protocol/openid-connect/certs",
      "end_session_endpoint": "{{request.baseUrl}}/realms/corp/protocol/openid-connect/logout",
      "response_types_supported": ["code"],
      "subject_types_supported": ["public"],
      "id_token_signing_alg_values_supported": ["RS256"]
    }
  }
}
